datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String               @id @default(uuid())
  username      String               @unique
  password_hash String
  full_name     String
  email         String               @unique
  phone         String?
  role          String
  status        String               @default("active")
  created_at    DateTime             @default(now())
  orders        Order[]              @relation("UserOrders")
  payments      Payment[]            @relation("CashierPayments")
  statusHistory OrderStatusHistory[] @relation("UserStatusHistory")
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Customer {
  id           String        @id @default(uuid())
  full_name    String
  phone        String?
  email        String?
  address      String?
  created_at   DateTime      @default(now())
  reservations Reservation[]
  orders       Order[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("active")
  products    Product[]
}

model Product {
  id          String      @id @default(uuid())
  category_id String
  name        String
  description String?
  price       Float
  quantity    Int         @default(0)
  status      String      @default("available")
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  category    Category    @relation(fields: [category_id], references: [id])
  orderItems  OrderItem[]
}

model RestaurantTable {
  id           String        @id @default(uuid())
  table_number String        @unique
  capacity     Int
  status       String        @default("available")
  reservations Reservation[]
  orders       Order[]
}

model Reservation {
  id               String          @id @default(uuid())
  customer_id      String
  table_id         String
  reservation_time DateTime
  number_of_people Int
  status           String          @default("pending")
  note             String?
  created_at       DateTime        @default(now())
  customer         Customer        @relation(fields: [customer_id], references: [id])
  table            RestaurantTable @relation(fields: [table_id], references: [id])
}

model Order {
  id            String               @id @default(uuid())
  customer_id   String?
  table_id      String?
  created_by    String
  total_amount  Float                @default(0)
  status        String               @default("pending")
  note          String?
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  customer      Customer?            @relation(fields: [customer_id], references: [id])
  table         RestaurantTable?     @relation(fields: [table_id], references: [id])
  creator       User                 @relation("UserOrders", fields: [created_by], references: [id])
  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
}

model OrderItem {
  id           String  @id @default(uuid())
  order_id     String
  product_id   String
  product_name String
  unit_price   Float
  quantity     Int
  subtotal     Float
  note         String?
  order        Order   @relation(fields: [order_id], references: [id])
  product      Product @relation(fields: [product_id], references: [id])
}

model Payment {
  id             String    @id @default(uuid())
  order_id       String    @unique
  cashier_id     String
  amount         Float
  payment_method String
  status         String    @default("pending")
  paid_at        DateTime?
  order          Order     @relation(fields: [order_id], references: [id])
  cashier        User      @relation("CashierPayments", fields: [cashier_id], references: [id])
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  order_id   String
  changed_by String
  old_status String
  new_status String
  note       String?
  changed_at DateTime @default(now())
  order      Order    @relation(fields: [order_id], references: [id])
  changer    User     @relation("UserStatusHistory", fields: [changed_by], references: [id])
}
